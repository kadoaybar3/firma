# Temel yapılandırma örneği. Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin.
# Gerçek anahtarları ASLA Git'e commitlemeyin (.gitignore .env'i kapsar).

# --- Supabase (🎡 henüz yapılandırılmadıysa boş bırakın; uygulama Demo Modunda çalışır) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Üretim adresi (Site URL): sitemap üretimi + canonical URL için ---
# Örnek: https://firma-rehberi.netlify.app
SITE_URL=

# --- Ödeme sağlayıcısı (gerçek kart ödemesi için; sunucu tarafında tutulacak anahtarlar
# backend/edge function'dedir. Bu değerler henüz yoksa boş bırakın) ---
VITE_PAYMENT_PROVIDER=iyzico
VITE_PAYMENT_CHECKOUT_URL=
